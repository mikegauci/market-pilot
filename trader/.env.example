# Trading mode — MUST be "paper" unless explicitly configured for live
TRADING_MODE=paper

# Safety: required to allow live mode (empty in dev)
LIVE_TRADING_CONFIRMATION=

# Interactive Brokers (IB Gateway paper default)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
# 1=live, 2=frozen, 3=delayed, 4=delayed frozen (use 1 when live data is available)
IBKR_MARKET_DATA_TYPE=1

# Watchlist (comma-separated)
WATCHLIST=NVDA,AAPL,MSFT,META,GOOGL,AMZN,TSLA,AMD,AVGO,JPM

# Supabase (service role — trader only, never in dashboard client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Market data source: mock (no IBKR) or ibkr
DATA_SOURCE=ibkr

# Execution: simulated (Supabase only) or ibkr (real paper orders)
EXECUTION_MODE=simulated
EVAL_INTERVAL_SEC=1
# Slower loop when DATA_SOURCE=ibkr and US market is closed (seconds)
CLOSED_MARKET_EVAL_INTERVAL_SEC=300
JEV_ENABLED=true
TYPESAFE_AI_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SEC=20
# Parallel Jev API calls per eval cycle (one slow symbol won't block the rest)
JEV_MAX_WORKERS=5

# Stock news enrichment for Jev (Finnhub free tier)
NEWS_ENABLED=true
FINNHUB_API_KEY=
NEWS_CACHE_TTL_SEC=600
NEWS_LOOKBACK_HOURS=24
NEWS_MAX_HEADLINES=5
# ETFs/index symbols skipped (company-news API is equity-oriented)
NEWS_SKIP_SYMBOLS=SPY,QQQ,IWM,DIA
NEWS_EMPTY_COOLDOWN_SEC=300
NEWS_FAILURE_COOLDOWN_SEC=60
NEWS_FETCH_WORKERS=3
NEWS_MAX_RETRIES=3

# Wait up to this long for IBKR bracket parent fills (paper can be slow)
IBKR_FILL_TIMEOUT_SEC=60
# After a failed IBKR entry, skip new attempts for this symbol (seconds)
IBKR_ENTRY_COOLDOWN_SEC=120

# Engine tuning
# Dashboard refresh: bot_status + positions (portfolio history throttled separately)
HEARTBEAT_INTERVAL_SEC=5
# How often to re-read bot enable/mode from dashboard (seconds)
BOT_CONTROL_REFRESH_INTERVAL_SEC=5
# How often to re-read risk settings and watchlist from dashboard (seconds)
SETTINGS_REFRESH_INTERVAL_SEC=15
# Steady-state portfolio_history inserts (always immediate on trade open/close)
PORTFOLIO_HISTORY_INTERVAL_SEC=30
# market_snapshots are unused by the dashboard; leave false unless you need the table
MARKET_SNAPSHOTS_ENABLED=false
# Advance risk recommendation tier when equity moves by this fraction (0.05 = 5%)
RISK_SYNC_THRESHOLD_PCT=0.05
LOG_LEVEL=INFO

# Strategy filters (optional — defaults shown)
# STRATEGY_MAX_SPREAD_PCT=0.0015
# STRATEGY_MAX_RSI=70
# STRATEGY_REQUIRE_PRICE_ABOVE_EMA20=true
# STRATEGY_MAX_SPY_DROP_5M_PCT=-0.3
# STRATEGY_MIN_BUY_HOLD_MARGIN=0.15
# STRATEGY_CONFIRMATION_CYCLES=2
# Max hold is configured in the dashboard Settings page (max_hold_minutes).
# Env override is unused when Supabase settings are available.
# STRATEGY_MAX_HOLD_MINUTES=0
# STRATEGY_JEV_SELL_EXIT_THRESHOLD=0.75
# STRATEGY_MAX_CORRELATED_POSITIONS=2
# STRATEGY_WARMUP_MIN_SAMPLES=30
# STRATEGY_WARMUP_MIN_SPAN_SEC=120
# STRATEGY_MIN_NEWS_SENTIMENT=-0.3
# STRATEGY_NEWS_BLOCK_TAGS=downgrade,lawsuit,sec_investigation,guidance_cut,layoffs
# STRATEGY_BLOCK_ON_EARNINGS=false
