# Trading mode — MUST be "paper" unless explicitly configured for live
TRADING_MODE=paper

# Safety: required to allow live mode (empty in dev)
LIVE_TRADING_CONFIRMATION=

# Interactive Brokers (IB Gateway paper default)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
# Leave empty to follow the IB Gateway/TWS paper login (managedAccounts).
# Set to pin one account (e.g. DUR217910) when multiple ids are visible.
IBKR_ACCOUNT=
# 1=live, 2=frozen, 3=delayed, 4=delayed frozen — paper accounts usually want 3.
# If IBKR error 10197 appears, close TWS/IBKR mobile/other API clients; the trader
# retries delayed streaming then falls back to snapshot quotes automatically.
IBKR_MARKET_DATA_TYPE=3

# Watchlist (comma-separated fallback when Supabase settings unavailable)
WATCHLIST=NVDA,AAPL,MSFT,META,GOOGL,AMZN,TSLA,AMD,AVGO,JPM

# IBKR bar cache for watchlist symbols
BAR_BACKFILL_PACING_SEC=12
BAR_DAILY_DURATION=1 W
BAR_INTRADAY_DURATION=3 D

# Supabase (service role — trader only, never in dashboard client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Market data source: mock (no IBKR) or ibkr
DATA_SOURCE=ibkr

# Execution: ibkr (paper orders via IB Gateway). simulated is legacy dashboard-only mode.
EXECUTION_MODE=ibkr
EVAL_INTERVAL_SEC=1
# Slower loop when DATA_SOURCE=ibkr and US market is closed (seconds)
CLOSED_MARKET_EVAL_INTERVAL_SEC=300
JEV_ENABLED=true
TYPESAFE_AI_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SEC=20
# Parallel Jev API calls per eval cycle (one slow symbol won't block the rest)
JEV_MAX_WORKERS=5

# Stock news enrichment for Jev (Finnhub free tier)
NEWS_ENABLED=true
FINNHUB_API_KEY=
NEWS_CACHE_TTL_SEC=600
NEWS_GENERAL_REFRESH_SEC=600
NEWS_GENERAL_KEEP=100
NEWS_LOOKBACK_HOURS=24
NEWS_MAX_HEADLINES=5
# ETFs/index symbols skipped (company-news API is equity-oriented)
NEWS_SKIP_SYMBOLS=SPY,QQQ,IWM,DIA
NEWS_EMPTY_COOLDOWN_SEC=300
NEWS_FAILURE_COOLDOWN_SEC=60
NEWS_FETCH_WORKERS=3
NEWS_MAX_RETRIES=3
# Optional OpenAI headline scorer for company news (regex fallback on failure)
NEWS_LLM_ENABLED=false
OPENAI_API_KEY=
NEWS_LLM_MODEL=gpt-4o-mini
NEWS_LLM_TIMEOUT_SEC=8
# Optional second OpenAI read on strong BUY predictions (stored on snapshot only)
OPENAI_SHADOW_READ_ENABLED=false

# Wait up to this long for IBKR bracket parent fills (paper can be slow)
IBKR_FILL_TIMEOUT_SEC=60
# After a failed IBKR entry, skip new attempts for this symbol (seconds)
IBKR_ENTRY_COOLDOWN_SEC=120

# Engine tuning
# Dashboard refresh: bot_status + positions (portfolio history throttled separately)
HEARTBEAT_INTERVAL_SEC=5
# How often to re-read bot enable/mode from dashboard (seconds)
BOT_CONTROL_REFRESH_INTERVAL_SEC=5
# How often to re-read risk settings and watchlist from dashboard (seconds)
SETTINGS_REFRESH_INTERVAL_SEC=15
# Steady-state portfolio_history inserts (always immediate on trade open/close)
PORTFOLIO_HISTORY_INTERVAL_SEC=30
# market_snapshots are unused by the dashboard; leave false unless you need the table
MARKET_SNAPSHOTS_ENABLED=false
# Advance risk recommendation tier when equity moves by this fraction (0.05 = 5%)
RISK_SYNC_THRESHOLD_PCT=0.05
LOG_LEVEL=INFO

# Strategy filters (optional — defaults shown)
# STRATEGY_MAX_SPREAD_PCT=0.0015
# STRATEGY_MAX_RSI=70
# STRATEGY_REQUIRE_PRICE_ABOVE_EMA20=false → entry EMA gate off when Supabase entry_ema_gate is not loaded
# Dashboard Settings entry_ema_gate (off | ema_9 | ema_20) overrides env when loaded
# STRATEGY_ROTATION_MIN_SESSION_CHANGE_PCT=0  # watchlist rotation: min % vs RTH open (off=none)
# STRATEGY_MAX_SPY_DROP_5M_PCT=-0.3
# STRATEGY_MIN_BUY_HOLD_MARGIN=0.15
# STRATEGY_CONFIRMATION_CYCLES=2  # overridden by dashboard Settings when Supabase is available
# STRATEGY_CONFIRMATION_SECONDS=30  # overridden by dashboard Settings when Supabase is available
# Max hold and min volume ratio are configured in the dashboard Settings page.
# Env override is unused when Supabase settings are available.
# STRATEGY_MAX_HOLD_MINUTES=0
# STRATEGY_JEV_SELL_EXIT_THRESHOLD=0.95
# STRATEGY_MAX_CORRELATED_POSITIONS=2
# STRATEGY_WARMUP_MIN_SAMPLES=30
# STRATEGY_WARMUP_MIN_SPAN_SEC=120
# STRATEGY_MIN_NEWS_SENTIMENT=-0.3
# STRATEGY_MIN_VOLUME_RATIO=0  # unused when Supabase settings are available; set min_volume_ratio in dashboard
# STRATEGY_NEWS_BLOCK_TAGS=downgrade,lawsuit,sec_investigation,guidance_cut,layoffs
# STRATEGY_BLOCK_ON_EARNINGS=false
# No new entries in the last N minutes before 16:00 ET (default 15 → cutoff ~15:45).
# STRATEGY_ENTRY_CUTOFF_MINUTES_BEFORE_CLOSE=15
# Flatten all open longs in the last N minutes before 16:00 ET (default 10 → ~15:50).
# Includes unrealized losers so DAY brackets are not held naked overnight.
# STRATEGY_EOD_FLATTEN_MINUTES_BEFORE_CLOSE=10

# Telegram trade alerts (optional). Leave blank to disable.
# 1. Message @BotFather, send /newbot, copy the token.
# 2. Message that bot, then open https://api.telegram.org/bot<token>/getUpdates
#    and copy message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
