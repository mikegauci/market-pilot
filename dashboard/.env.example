# Supabase (publishable key only — never service_role in the dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paper account for trade history when bot_status has no ibkr_account_id (not secret).
# Also exposed to the browser via next.config for client polling (same value as Vercel).
DASHBOARD_IBKR_ACCOUNT_ID=

# Analytics → Session brief (server only)
OPENAI_API_KEY=
# OPENAI_BRIEF_MODEL=gpt-4o-mini

# Optional: comma-separated dev origins for Next.js allowedDevOrigins
# ALLOWED_DEV_ORIGINS=
